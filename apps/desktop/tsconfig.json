{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node", "electron-vite/node", "bun-types/test"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@cw-code/client": ["../../packages/client/src/index.ts"],
      "@cw-code/contracts": ["../../packages/contracts/src/index.ts"],
      "@cw-code/shared/*": ["../../packages/shared/src/*"],
      "@cw-code/server/*": ["../server/src/*"]
    }
  },
  "include": ["src", "electron.vite.config.ts"]
}
