{
  "name": "cw-code",
  "version": "0.0.1-alpha.21",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "trustedDependencies": [
    "electron",
    "esbuild",
    "node-pty"
  ],
  "scripts": {
    "dev": "bun --filter @cw-code/desktop dev",
    "build": "bun --filter '*' build",
    "test": "bun --filter '*' test",
    "typecheck": "bun --filter '*' typecheck",
    "dist": "bun --filter @cw-code/desktop dist",
    "release:plan": "bun tools/release/src/cli/release.ts plan"
  },
  "description": "A desktop workspace for Claude Code, OpenCode, and Codex.",
  "license": "MIT",
  "homepage": "https://github.com/albertofa/cw-code"
}
